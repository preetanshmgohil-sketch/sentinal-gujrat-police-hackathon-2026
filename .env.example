# Sentinel VMS Environment Configuration
# Copy this file to .env and configure your variables

# Flask Server Configuration
SENTINEL_HOST=0.0.0.0
SENTINEL_PORT=5000
SENTINEL_GATEWAY=https://live.sentinelgujarat.in

# NVIDIA NIM API Configuration (for Scene Analysis & Violation Detection)
# Get your API key from https://build.nvidia.com
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# ANPR Configuration
ANPR_BACKEND=easyocr
ANPR_MIN_CONFIDENCE=0.25
